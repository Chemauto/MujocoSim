<?xml version="1.0" encoding="utf-8"?>
<mujoco model="push_box_scene">
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <global azimuth="-120" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="scene_groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="scene_groundplane" texture="scene_groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <!-- castshadow=false: 同 flat.xml, 大平面阴影贴图渲染极慢 -->
    <light pos="0 0 3.5" dir="0 0 -1" directional="true" castshadow="false"/>
    <geom name="floor" type="plane" size="20 20 0.05" material="scene_groundplane"/>

    <body name="support_box" pos="1.5 0 0.12">
      <freejoint/>
      <geom name="support_box_geom" type="box" size="0.3 0.4 0.12" rgba="0.7 0.5 0.2 1" mass="8"/>
    </body>

    <geom name="goal_mark" type="box" pos="3 0 0.01" size="0.4 0.5 0.01" rgba="0.2 0.8 0.2 0.35" contype="0" conaffinity="0"/>

  </worldbody>
</mujoco>
